{
  "name": "wcag-contrast-backend",
  "version": "1.0.0",
  "description": "WCAG 文本对比度与透明叠色核验后端（API 与 CLI）",
  "type": "commonjs",
  "main": "dist/index.js",
  "bin": {
    "wcag": "dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --experimental-sqlite \"dist-test/**/*.test.js\"",
    "start": "node --experimental-sqlite dist/server/start.js",
    "demo": "node --experimental-sqlite dist/demo.js",
    "cli": "node --experimental-sqlite dist/cli/index.js",
    "pretest": "tsc -p tsconfig.test.json"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
